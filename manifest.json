{
  "manifest_version": 3,
  "name": "Scroll Stop",
  "short_name": "Scroll Stop",
  "version": "1.5.4",
  "description": "Block distracting sites and bring your own focus goals back when attention drifts.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "favicon",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Scroll Stop",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-blue-v2-16.png",
      "32": "images/icon-blue-v2-32.png"
    }
  },
  "icons": {
    "16": "images/icon-blue-v2-16.png",
    "32": "images/icon-blue-v2-32.png",
    "48": "images/icon-blue-v2-48.png",
    "128": "images/icon-blue-v2-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "styles/tokens.css",
        "styles/blocked.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
